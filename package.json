{
  "name": "metro-notation",
  "private": true,
  "type": "module",
  "homepage": "https://kitao.dev/metro-notation/",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/cloudflare.mjs dev --local --ip 127.0.0.1 --port 4175",
    "prepreview": "npm run build -- --preview",
    "deploy": "node scripts/cloudflare.mjs deploy --strict",
    "predeploy": "npm test && npm run build"
  },
  "devDependencies": {
    "marked": "18.1.1",
    "wrangler": "4.150.0"
  }
}
