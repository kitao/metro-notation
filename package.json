{
  "name": "metro-notation",
  "private": true,
  "type": "module",
  "homepage": "https://kitao.dev/metro-notation/",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/wrangler.mjs dev --port 4177",
    "build": "node scripts/build-site.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run lint && npm run format:check && npm test && npm run test:browser",
    "deploy:check": "npm run check && node scripts/wrangler.mjs deploy --dry-run",
    "deploy": "npm run deploy:check && node scripts/wrangler.mjs deploy --strict"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "axe-core": "4.11.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "marked": "18.1.1",
    "parse5": "8.0.1",
    "prettier": "3.9.9",
    "wrangler": "4.150.0"
  }
}
